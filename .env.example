# Acer / FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
DEVICE_TOKEN=change-me

# LLM memory proxy over WireGuard
OLLAMA_BASE_URL=http://192.168.0.100:8780
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_S=180
OLLAMA_NUM_CTX=4096

# Local STT on Acer
STT_ENABLED=true
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ru
STT_CPU_THREADS=4
STT_BEAM_SIZE=1

# Local Silero TTS on Acer
TTS_ENGINE=silero
TTS_TARGET_RATE=24000
TTS_SILERO_MODEL_PATH=data/models/silero/v5_5_ru.pt
TTS_SILERO_SPEAKER=eugene
TTS_SILERO_SAMPLE_RATE=24000
TTS_CPU_THREADS=4
TTS_SAPI_FALLBACK=false

# Wake/VAD
WAKE_ENABLED=true
WAKE_WORD=микро
WAKE_ALIASES=микро,эй микро,микра,привет микро
VAD_AUTO_THRESHOLD=true
VAD_NOISE_MULTIPLIER=2.0
VAD_END_SILENCE_MS=620

# X79 telemetry
X79_MONITOR_ENABLED=true
X79_MONITOR_URL=http://192.168.0.100:8765/stats
X79_MONITOR_POLL_S=10
